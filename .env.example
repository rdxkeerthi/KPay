# ============================================================================
# KPay — Environment Configuration Template
# ============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# WARNING: NEVER commit your real '.env' file containing live secrets to Git!

# ─── Environment Mode ────────────────────────────────────────────────────────
# Options: 'sandbox' (testing/staging) | 'production' (live transactions)
KPAY_ENVIRONMENT=sandbox

# ─── 1. PhonePe Business Credentials (https://business.phonepe.com) ──────────
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1

# ─── 2. Paytm Business Credentials (https://business.paytm.com) ──────────────
PAYTM_MERCHANT_ID=YOUR_PAYTM_MID
PAYTM_MERCHANT_KEY=YOUR_PAYTM_MERCHANT_KEY
PAYTM_WEBSITE=WEBSTAGING # 'WEBSTAGING' for sandbox, 'DEFAULT' for production

# ─── 3. BharatPe Merchant Credentials (https://bharatpe.com) ─────────────────
BHARATPE_MERCHANT_ID=YOUR_BHARATPE_MID
BHARATPE_API_KEY=YOUR_BHARATPE_API_KEY
BHARATPE_SECRET_KEY=YOUR_BHARATPE_SECRET_KEY

# ─── 4. Direct Bank Mode (Personal / Current Bank VPA) ───────────────────────
# Collect directly into ANY personal or current bank account without merchant KYC
DIRECT_UPI_VPA=yourname@okhdfcbank
DIRECT_PAYEE_NAME="Acme Store"
DIRECT_MCC=5411 # 4-digit NPCI Merchant Category Code (optional)
DIRECT_WEBHOOK_SECRET=your_custom_secret_for_sms_forwarder

# ─── 5. Server & Webhook Endpoints ───────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000
CALLBACK_URL=http://localhost:3000/api/kpay/webhook
REDIRECT_URL=http://localhost:3000/checkout/success
