# ============================================================================
# KPay — Git Attributes & Line Ending Normalization
# ============================================================================

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit source code files
*.ts text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts (must preserve CRLF if needed)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Package lock files (preserve during merge)
package-lock.json -diff
